{
  "name": "@vbyte/core-cmd",
  "version": "2.0.0",
  "description": "Command Bitcoin Core using a suite of automation tools.",
  "author": "Christopher Scott",
  "license": "MIT",
  "keywords": [
    "bitcoin",
    "bitcoin-core",
    "bitcoind",
    "regtest",
    "testnet",
    "signet",
    "rpc",
    "cli",
    "automation",
    "testing",
    "ci-cd",
    "wallet",
    "transaction"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vbyte-dev/core-cmd.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist/*",
    "release": "npm run clean && npm test && npm run build",
    "scratch": "tsx test/scratch.ts",
    "test": "tsx test/runners/ci.ts",
    "test:unit": "tsx test/runners/unit.ts",
    "test:integration": "tsx test/runners/integration.ts",
    "test:e2e": "tsx test/runners/e2e.ts",
    "test:ci": "CI=true tsx test/runners/ci.ts",
    "test:debug": "DEBUG=true tsx test/runners/integration.ts",
    "test:legacy": "tsx test/runners/legacy.ts"
  },
  "dependencies": {
    "@scure/bip32": "^2.0.1",
    "@scure/btc-signer": "^2.0.1",
    "@vbyte/btc-dev": "^2.1.0",
    "@vbyte/buff": "^1.1.0",
    "@vbyte/crypto": "^1.0.1",
    "@vbyte/util": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/tape": "^5.8.1",
    "glob": "^13.0.0",
    "tape": "^5.9.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "zeromq": "^6.0.0"
  }
}
